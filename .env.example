# ---------------------------------------------------------------------------
# NexusRAG environment
#
# Copy to `.env` at the repo root and fill in. Every value below is read at
# runtime by the web app, the workers, or the AI service -- none of them are
# compiled in.
#
#   cp .env.example .env
#   pnpm doctor      # tells you what is missing and what connects
#
# This file is the single source of truth for both stacks. Next.js reads it via
# @repo/database, and apps/ai-service resolves the same path from
# src/ai_service/config.py.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_URL=http://localhost:3000

# --- PostgreSQL -------------------------------------------------------------
# Managed examples:
#   Aiven      postgresql://USER:PASSWORD@HOST:PORT/nexusrag?sslmode=require
#   Neon       postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/nexusrag?sslmode=require
#   Supabase   postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
#
# TLS is handled automatically: @repo/database enables SSL for any host that is
# not localhost/127.0.0.1, so append ?sslmode=require for managed providers.
DATABASE_URL=""

# --- Redis (sessions + BullMQ queue) ----------------------------------------
# Managed examples:
#   Upstash    rediss://default:<token>@xxx.upstash.io:6379
#   Redis Cloud rediss://default:<password>@xxx.cloud.redislabs.com:16379
#
# Use the rediss:// scheme for managed providers. The `s` selects TLS.
# Blocked-repo jobs require maxRetriesPerRequest=null, which @repo/redis sets
# automatically for the worker.
REDIS_URL=""

# --- Object storage (repository archives) -----------------------------------
# Two mutually exclusive options. Whichever is fully populated is used; S3_*
# takes priority so a self-hosted MinIO can be swapped in without clearing R2.
#
# Option A -- Cloudflare R2
#   R2 Dashboard -> Account Details -> Account ID
#   R2 Dashboard -> Access Keys -> Manage R2 API Tokens
#   Dashboard -> Storage -> create a bucket
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Option B -- MinIO or any S3-compatible provider (self-hosted included)
#   MinIO Console -> Access Keys
#   Access Key becomes S3_ACCESS_KEY, Secret Key becomes S3_SECRET_KEY
#   Local MinIO default endpoint: http://localhost:9000
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# --- Qdrant (vector search) -------------------------------------------------
# Cloud:  https://<cluster-id>.aws.cloud.qdrant.io:6333
# Local:   http://localhost:6333
# The API key is Cluster Settings -> API Keys in the Qdrant Cloud console.
QDRANT_URL=""
QDRANT_API_KEY=""

# --- Elasticsearch (lexical search) -----------------------------------------
# Cloud:  https://<deployment>.es.<region>.<provider>.cloud.es.io:443
# Local:  http://localhost:9200
# Elastic Cloud -> Copy as cURL -> look for "Authorization: ApiKey <base64>".
# The value below is the base64 string ONLY, without the "ApiKey " prefix.
ELASTICSEARCH_URL=""
ELASTICSEARCH_API_KEY=""
# Alternative to the API key:
# ELASTICSEARCH_USERNAME=""
# ELASTICSEARCH_PASSWORD=""
# Set to false ONLY for self-signed development certificates.
# ELASTICSEARCH_REJECT_UNAUTHORIZED=false
# ELASTICSEARCH_INDEX=code_chunks

# --- Neo4j (code graph) -----------------------------------------------------
# Aura:  neo4j+s://<id>.databases.neo4j.io
# Local: bolt://localhost:7687
#
# The `+s` scheme means TLS and must be copied verbatim. Credentials are in
# Aura -> Connection details.
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
# Only needed for a plain neo4j:// endpoint that should use TLS.
# NEO4J_ENCRYPTED=false

# --- GitHub -----------------------------------------------------------------
# OAuth app credentials. Settings -> Developer settings -> OAuth Apps.
# Homepage URL:            http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional personal access token for OUTBOUND API calls (metadata, archive
# URLs). Separate from the OAuth app above. Without it GitHub allows only ~60
# requests/hour, which a handful of repository submissions will exhaust.
# GITHUB_TOKEN=""

# --- Email (password reset) -------------------------------------------------
# Resend dashboard -> API Keys, and a verified sending domain.
RESEND_API_KEY=""
EMAIL_FROM="NexusRAG <noreply@example.com>"


# --- AI ---------------------------------------------------------------------
# Chat and embeddings are configured separately, so each can use a different
# host, model and key. The wire format is the OpenAI one, which most hosted
# inference servers accept unchanged -- so switching vendor is a .env edit.

# Chat / answer generation.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# Embeddings.
#
# EMBEDDING_DIMENSIONS must match the output size of EMBEDDING_MODEL, and the
# Qdrant collection is built to match. Known values:
#
#   text-embedding-3-small      1536
#   text-embedding-3-large      3072
#   text-embedding-ada-002      1536
#   gemini-embedding-001        3072
#   gemini-embedding-2-preview  3072
#
# Vectors from different embedding models live in different spaces: changing
# EMBEDDING_MODEL means every repository must be re-indexed. The collection is
# recreated automatically when the size changes, but the vectors are not.
#
# EMBEDDING_BASE_URL falls back to LLM_BASE_URL, and EMBEDDING_API_KEY falls back
# to LLM_API_KEY then OPENAI_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Fallback credential for both capabilities above.
OPENAI_API_KEY=""

# --- Optional observability -------------------------------------------------
# Sentry, PostHog, or similar. Not read by any code yet.
# SENTRY_DSN=""
# --- AI service (apps/ai-service) ---------------------------------------
# Where the Next.js API proxies /api/ask. Must be reachable server-side only;
# never expose this port to the browser.
AI_SERVICE_URL=http://localhost:8000

# --- Indexing completion callback --------------------------------------------
# Shared bearer secret the Python indexer uses to report INDEXING -> READY or
# FAILED back to Next.js (POST /api/internal/indexing-complete). Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# WEB_BASE_URL is where the indexer posts the callback (the public web origin).
INTERNAL_API_KEY=
WEB_BASE_URL=http://localhost:3000
