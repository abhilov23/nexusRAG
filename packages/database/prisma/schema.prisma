generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String   @id @default(cuid())
    email        String   @unique
    passwordHash String?
    name         String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    accounts OAuthAccount[]
    settings UserSettings?
    repositories Repository[]
    queryLogs QueryLog[]
    evaluationRuns EvaluationRun[]
}

model OAuthAccount {
    id                String @id @default(cuid())
    provider          String
    providerAccountId String
    userId            String
    user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
}

/// Per-user workspace + indexing preferences backing the Settings page.
/// Kept as a typed 1:1 table (rather than a JSON blob) so defaults, casts and
/// future migrations stay explicit. Rows are created lazily on first write.
model UserSettings {
    id     String @id @default(cuid())
    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    workspaceName String @default("Nexus Labs")
    workspaceSlug String @default("nexus-labs")

    defaultBranch    String  @default("main")
    autoIndex        Boolean @default(true)
    includeCitations Boolean @default(true)
    indexAlerts      Boolean @default(true)
    weeklySummary    Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
/// Lifecycle of a repository's raw archive ingestion.
/// QUEUED -> DOWNLOADING -> UPLOADING -> INDEXING -> READY, with FAILED as the
/// terminal error state. Retries reuse the same record, so this always reflects
/// the most recent attempt rather than a permanent verdict.
/// READY means vectors, lexical documents and the code graph were all written
/// (best-effort stores may still be partial -- see errorMessage), never merely
/// that the archive landed in object storage.
enum RepositoryStatus {
    QUEUED
    DOWNLOADING
    UPLOADING
    INDEXING
    READY
    FAILED
}

/// A GitHub repository submitted for ingestion.
///
/// The two SHA columns are what make re-submission cheap and safe:
///   * `latestSha` -- newest commit seen on `defaultBranch` at the last check
///   * `commitSha`  -- commit whose archive is actually stored in R2
/// A repository needs (re-)ingestion exactly when `latestSha != commitSha`,
/// which lets the caller skip work for unchanged repositories.
///
/// `storageKey` points at the archive in Cloudflare R2. The archive itself is
/// never held in PostgreSQL or Redis.
model Repository {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    /// Canonical https://github.com/{owner}/{name}
    githubUrl String
    owner     String
    name      String

    defaultBranch String?

    /// Newest commit observed on defaultBranch during the last GitHub check.
    latestSha String?

    /// Commit whose archive is currently stored in R2. Null until first success.
    commitSha String?

    /// R2 object key: repositories/{userId}/{id}/{commitSha}.tar.gz
    storageKey String?

    /// Size of the downloaded archive in bytes.
    sizeBytes Int?

    /// GitHub's last push timestamp; a cheap secondary change signal.
    pushedAt DateTime?

    license     String?
    description String?

    status       RepositoryStatus @default(QUEUED)
    errorMessage String?
    lastIngestedAt DateTime?

    /// Dominant chunk language measured at index time (e.g. "python").
    /// Null until the indexing stage reports back.
    language String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    queryLogs QueryLog[]
    evaluationRuns EvaluationRun[]

    @@unique([userId, owner, name])
    @@index([userId])
    @@index([status])
}

/// One persisted RAG request, whether it came from chat or a benchmark.
///
/// The scalar timings and token counts are columns rather than JSON because the
/// dashboard aggregates them. `trace` and `sources` are JSON because they are
/// read as a whole by the trace drawer and never filtered on.
model QueryLog {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    /// Null when the question spanned every READY repository.
    repositoryId String?
    repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

    evaluationRunId   String?
    evaluationRun     EvaluationRun? @relation(fields: [evaluationRunId], references: [id], onDelete: SetNull)
    evalQuestionIndex Int?

    mode   QueryMode @default(CHAT)
    status QueryStatus

    question String
    answer   String?
    /// Sanitized client-facing reason; never the upstream exception.
    errorMessage String?

    grounded Boolean @default(false)
    model    String?

    latencyMs           Int?
    retrievalLatencyMs  Int?
    generationLatencyMs Int?

    promptTokens     Int @default(0)
    completionTokens Int @default(0)
    totalTokens      Int @default(0)
    /// Estimated USD, from configured per-million token rates.
    costUsd          Float @default(0)

    sourceCount Int @default(0)

    /// Source list and full retrieval trace, stored for the trace drawer.
    sources Json?
    /// Exact prompt/context sent to the answer model, capped before storage.
    context String?
    trace   Json?

    /// Ground-truth evaluation fields. Null outside labelled benchmark runs.
    expectedPaths  String[] @default([])
    retrievalK     Int?
    recallAtK      Float?
    precisionAtK   Float?
    mrr            Float?

    /// Model-judged answer quality. Explicitly not ground truth.
    faithfulness   Float?
    relevance      Float?
    judgeRationale String?
    judgedAt       DateTime?

    /// -1 = negative, 1 = positive, null = not rated.
    feedback   Int?
    feedbackAt DateTime?

    createdAt DateTime @default(now())

    @@index([userId, createdAt])
    @@index([repositoryId, createdAt])
    @@index([evaluationRunId])
    @@index([userId, mode, createdAt])
}

enum QueryStatus {
    SUCCESS
    ERROR
}

enum QueryMode {
    CHAT
    EVALUATION
}

enum EvaluationRunStatus {
    RUNNING
    COMPLETED
    CANCELLED
    FAILED
}

/// A labelled benchmark: one fixed question set against one repository.
/// `questions` stores [{ question, expectedPaths }] so the server, not the
/// browser, owns the ground truth used to compute Recall@K.
model EvaluationRun {
    id     String @id @default(cuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    repositoryId String
    repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

    name         String?
    status       EvaluationRunStatus @default(RUNNING)
    retrievalK   Int                 @default(10)
    judgeAnswers Boolean             @default(true)
    questions    Json

    startedAt   DateTime  @default(now())
    completedAt DateTime?
    createdAt   DateTime  @default(now())

    queries QueryLog[]

    @@index([userId, createdAt])
    @@index([repositoryId, createdAt])
    @@index([status])
}
