    "@repo/storage": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^18.0.4",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "tsx": "^4.19.2",
    "typescript": "7.0.2"
  }
}
