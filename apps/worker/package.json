{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check-types": "tsc --noEmit",
    "test:live": "tsc && node test/live.mjs"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
